{
  "name": "supportos",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "node -r ts-node/register prisma/seed.ts",
    "test": "npm --prefix apps/api test",
    "test:security": "npm --prefix apps/api run test:security"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  }
}

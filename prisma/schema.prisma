// SupportOS Multi-Tenant Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("GROWTH") // FREE, TEAM, BUSINESS, ENTERPRISE
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces      Workspace[]
  users           User[]
  teams           Team[]
  inboxes         Inbox[]
  customers       Customer[]
  conversations   Conversation[]
  tickets         Ticket[]
  categories      Category[]
  articles        Article[]
  automationRules AutomationRule[]
  auditEvents     AuditEvent[]
  webhookEvents   WebhookEvent[]

  @@map("organizations")
}

model Workspace {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inboxes       Inbox[]
  conversations Conversation[]

  @@unique([organizationId, slug])
  @@map("workspaces")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  role           String       @default("AGENT") // OWNER, ADMIN, AGENT
  status         String       @default("ACTIVE") // ACTIVE, INVITED, DEACTIVATED
  isAvailable    Boolean      @default(true)
  avatarUrl      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  teamMemberships TeamMember[]
  assignedConvs   Conversation[]  @relation("AssignedAgent")
  assignedTickets Ticket[]        @relation("AssignedTicketAgent")
  ticketComments  TicketComment[]
  authoredArticles Article[]
  refreshTokens   RefreshToken[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members       TeamMember[]
  conversations Conversation[]
  tickets       Ticket[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

model Inbox {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String?
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  name           String
  channelType    String       @default("WEB_WIDGET") // WEB_WIDGET, EMAIL, API
  inboxKey       String       @unique
  widgetColor    String       @default("#2563EB")
  greeting       String       @default("Hello! How can we assist you today?")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversations   Conversation[]
  visitorSessions VisitorSession[]

  @@index([organizationId])
  @@map("inboxes")
}

model Customer {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String?
  avatarUrl        String?
  customAttributes String? // JSON stringified key-values
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  conversations   Conversation[]
  tickets         Ticket[]
  visitorSessions VisitorSession[]

  @@index([organizationId, email])
  @@map("customers")
}

model Conversation {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId     String?
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  inboxId         String
  inbox           Inbox        @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assigneeId      String?
  assignee        User?        @relation("AssignedAgent", fields: [assigneeId], references: [id], onDelete: SetNull)
  teamId          String?
  team            Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  status          String       @default("OPEN") // OPEN, PENDING, SNOOZED, RESOLVED
  priority        String       @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  lastMessageAt   DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  messages        Message[]
  tickets         Ticket[]
  visitorSessions VisitorSession[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, assigneeId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  organizationId String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String // CUSTOMER, AGENT, SYSTEM, AI_BOT
  senderId       String? // references User.id or Customer.id
  senderName     String?
  messageType    String       @default("PUBLIC_REPLY") // PUBLIC_REPLY, INTERNAL_NOTE
  content        String
  createdAt      DateTime     @default(now())

  attachments Attachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  fileSize  Int
  mimeType  String
  storageKey String
  url       String
  createdAt DateTime @default(now())

  @@map("attachments")
}

model Ticket {
  id             String       @id @default(uuid())
  ticketNumber   Int
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       User?        @relation("AssignedTicketAgent", fields: [assigneeId], references: [id], onDelete: SetNull)
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  title          String
  description    String
  status         String       @default("NEW") // NEW, OPEN, PENDING, ON_HOLD, RESOLVED, CLOSED
  priority       String       @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueAt          DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  comments TicketComment[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("ticket_comments")
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  orderIndex     Int          @default(0)
  createdAt      DateTime     @default(now())

  articles Article[]

  @@unique([organizationId, slug])
  @@map("categories")
}

model Article {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  content        String
  status         String       @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  viewCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("articles")
}

model AutomationRule {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean      @default(true)
  triggerEvent   String // conversation.created, message.created, ticket.created
  conditions     String // JSON serialized conditions
  actions        String // JSON serialized actions
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, triggerEvent])
  @@map("automation_rules")
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  action         String // USER_LOGIN, CONVERSATION_RESOLVED, TICKET_CREATED, etc.
  entityType     String // Conversation, Ticket, User, Organization
  entityId       String?
  metadata       String? // JSON details
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String    @default(uuid())
  revoked   Boolean   @default(false)
  expiresAt DateTime
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model WebhookEvent {
  id             String       @id @default(uuid())
  eventId        String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          String
  status         String       @default("PROCESSED")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("webhook_events")
}

model VisitorSession {
  id             String        @id @default(uuid())
  inboxId        String
  inbox          Inbox         @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tokenHash      String        @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([inboxId, customerId])
  @@index([conversationId])
  @@map("visitor_sessions")
}

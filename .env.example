# SupportOS Environment Configuration

# Application Ports & Environment
PORT=4000
WEB_PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Connection (Zero-Trust Role Separation Architecture)
# ------------------------------------------------------------------------------
# Local Development (SQLite zero-config fallback):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL Architecture:
# 1. DATABASE_URL: Dedicated runtime role (supportos_app) connecting via transaction pooler.
#    Strictly NOSUPERUSER, NOBYPASSRLS, zero table ownership.
# DATABASE_URL="postgresql://supportos_app:YOUR_APP_ROLE_PASSWORD@ep-round-recipe-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. DIRECT_URL: Administrative owner role used strictly for schema migrations, DDL, and role provisioning.
# DIRECT_URL="postgresql://neondb_owner:YOUR_MIGRATION_ADMIN_PASSWORD@ep-round-recipe.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 3. APP_ROLE_PASSWORD: Password used by `npm run db:provision-roles` to provision/rotate supportos_app credentials.
# APP_ROLE_PASSWORD="YOUR_APP_ROLE_PASSWORD"

# Authentication & JWT Secrets (Must be cryptographically random >= 32 chars in production)
JWT_SECRET="supportos_super_secret_jwt_key_enterprise_2026_change_in_production"
JWT_EXPIRES_IN="15m"

# Billing Webhook Secret (HMAC-SHA256 signature verification)
BILLING_WEBHOOK_SECRET="supportos_super_secret_billing_webhook_key_2026_change_in_production"

# Redis & Distributed Concurrency
# Set REQUIRE_REDIS=true in production to enforce distributed rate limiting and WebSocket scalability.
REDIS_URL="redis://localhost:6379"
REQUIRE_REDIS="false"

# Public API, Frontend & Widget
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# CORS Configuration (Comma-separated allowed administrative origins)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
ALLOWED_WIDGET_ORIGINS="*"

# Reverse Proxy Trust (Set to true behind Cloudflare / Nginx / ALB)
TRUST_PROXY="false"

# Object Storage (Local fallback / AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER="local"
S3_BUCKET="supportos-attachments"
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Email Provider Configuration (SMTP / Resend / SendGrid)
EMAIL_DRIVER="mock"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="SupportOS <notifications@supportos.dev>"
RESEND_API_KEY=""

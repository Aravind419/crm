# SupportOS Environment Configuration

# Application Ports
PORT=4000
WEB_PORT=3000
NODE_ENV=development

# Database Connection (SQLite for zero-config local dev; PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supportos?schema=public"

# Authentication & JWT Secrets
JWT_SECRET="supportos_super_secret_jwt_key_enterprise_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Public API & Widget
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Object Storage (Local fallback / AWS S3 / MinIO)
STORAGE_DRIVER="local"
S3_BUCKET="supportos-attachments"
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Email Provider Configuration (SMTP / Resend)
EMAIL_DRIVER="mock"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SupportOS <notifications@supportos.dev>"
